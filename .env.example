# .env 模板：复制本文件并重命名为 .env，然后填入你的 key
# 注意：.env 已被 .gitignore 排除，永远不要把它提交到 git

# 必填：你的 DeepSeek API Key（sk- 开头）
DEEPSEEK_API_KEY=

# 可选：换模型平台 / 调参数时，取消注释并修改
# 通义千问:  DEEPSEEK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  DEEPSEEK_MODEL=qwen-plus
# 智谱:      DEEPSEEK_BASE_URL=https://open.bigmodel.cn/api/paas/v4               DEEPSEEK_MODEL=glm-4-flash
# MAX_STEPS=5
